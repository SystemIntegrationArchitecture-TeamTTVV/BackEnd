# Sao chép thành .env trong cùng thư mục (hoặc export trong OS / IDE).
# Không commit file .env.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis Cloud — subscription database-MNMQ2UIL (endpoint đã gắn trong application.properties)
# Bắt buộc: mật khẩu ACL user "default" từ Redis Cloud dashboard
REDIS_PASSWORD=
# Tuỳ chọn tắt lưu token khi dev không có Redis: APP_TOKEN_STORE_ENABLED=false
APP_TOKEN_STORE_ENABLED=true
